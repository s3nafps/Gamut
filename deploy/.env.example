# Copy this file to .env and fill it in.

# Database password (long and random). Keep it secret.
DB_PASSWORD=change-me-to-a-long-random-password

# Factory time zone — "today" on the dashboards starts at midnight in this zone.
# Examples: Africa/Casablanca, Africa/Algiers, Africa/Tunis, Europe/Paris
TZ=Africa/Casablanca

# Port the PCs use to reach the server (http://<server>:8080)
PORT=8080

# Nightly backup: hour of day (0-23), how many days to keep, and where to store them.
# Point BACKUP_DIR to a second disk or a network share (NAS) if you can.
BACKUP_HOUR=2
KEEP_DAYS=30
BACKUP_DIR=./backups

# true = fill a NEW database with example models, colors and test users. Keep false for real use.
SEED_DEMO=false
