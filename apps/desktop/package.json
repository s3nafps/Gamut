{
  "name": "@gamut/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Gamut Repair desktop app for the factory PCs",
  "author": "Gamut",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "check": "node --check src/main.cjs && node --check src/preload.cjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.gamut.repair",
    "productName": "Gamut Repair",
    "directories": {
      "output": "release",
      "app": "."
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gamut Repair",
      "uninstallDisplayName": "Gamut Repair"
    },
    "npmRebuild": false,
    "electronVersion": "33.4.11",
    "executableName": "GamutRepair",
    "artifactName": "Gamut-Repair-Setup-${version}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s3nafps/Gamut.git"
  }
}
